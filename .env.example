# ─── Variables de entorno del frontend (lia / damiana-bella) ───
# Copiá este archivo a .env.local para desarrollo.
# En Vercel, cargá estas mismas claves en Project Settings → Environment Variables.
# Todas deben empezar con VITE_ para que Vite las exponga al cliente.

# Supabase (lecturas públicas de catálogo, auth, contenido del sitio)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend Express propio (auth, órdenes, pagos, Cloudinary, envíos).
# OJO: pese al nombre "_LOCAL", es la URL base del backend en TODOS los entornos.
# Debe incluir el sufijo /api. Ej. local: http://localhost:3000/api
# Ej. prod/túnel: https://tu-backend.ejemplo.com/api
VITE_API_URL_LOCAL=

# Site key pública de Cloudflare Turnstile (captcha). Vacía = captcha desactivado.
# Activarlo también en Supabase: Authentication → Attack Protection → CAPTCHA (Turnstile, con la secret key).
VITE_TURNSTILE_SITE_KEY=

# Token público de Cloudflare Web Analytics (Core Web Vitals). Vacío = sin medición.
# Se obtiene en Cloudflare → Analytics y Logs → Web Analytics → Add a site.
VITE_CF_ANALYTICS_TOKEN=
